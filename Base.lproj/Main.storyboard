<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22154" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="nav-vc-001">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Navigation Controller-->
        <scene sceneID="nav-sc-001">
            <objects>
                <navigationController automaticallyAdjustsScrollViewInsets="NO" id="nav-vc-001" sceneMemberID="viewController">
                    <toolbarItems/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" insetsLayoutMarginsFromSafeArea="NO" id="nav-bar-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="44"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="gal-vc-001" kind="relationship" relationship="rootViewController" id="rel-nav-001"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="nav-fr-001" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-200" y="0"/>
        </scene>
        <!--Galeria View Controller-->
        <scene sceneID="gal-sc-001">
            <objects>
                <viewController id="gal-vc-001" customClass="GaleriaViewController" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="gal-vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="808"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <collectionView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" dataMode="prototypes" translatesAutoresizingMaskIntoConstraints="NO" id="col-vw-001">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="808"/>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                <collectionViewFlowLayout key="collectionViewLayout" minimumLineSpacing="10" minimumInteritemSpacing="10" id="flw-ly-001">
                                    <size key="itemSize" width="170" height="220"/>
                                    <size key="headerReferenceSize" width="0.0" height="0.0"/>
                                    <size key="footerReferenceSize" width="0.0" height="0.0"/>
                                    <inset key="sectionInset" minX="10" minY="10" maxX="10" maxY="10"/>
                                </collectionViewFlowLayout>
                                <cells>
                                    <collectionViewCell opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" reuseIdentifier="ObraCell" id="cel-vw-001" customClass="ObraCollectionViewCell" customModuleProvider="target">
                                        <rect key="frame" x="10" y="10" width="170" height="220"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                        <view key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" id="cel-cv-001">
                                            <rect key="frame" x="0.0" y="0.0" width="170" height="220"/>
                                            <autoresizingMask key="autoresizingMask"/>
                                            <subviews>
                                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="cel-img-001">
                                                    <rect key="frame" x="0.0" y="0.0" width="170" height="160"/>
                                                </imageView>
                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Título da Obra" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="cel-ttl-001">
                                                    <rect key="frame" x="8" y="166" width="154" height="18"/>
                                                    <fontDescription key="fontDescription" type="boldSystem" pointSize="14"/>
                                                    <color key="textColor" systemColor="labelColor"/>
                                                    <nil key="highlightedColor"/>
                                                </label>
                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Artista" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="cel-art-001">
                                                    <rect key="frame" x="8" y="186" width="154" height="16"/>
                                                    <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                                    <color key="textColor" systemColor="secondaryLabelColor"/>
                                                    <nil key="highlightedColor"/>
                                                </label>
                                            </subviews>
                                            <constraints>
                                                <constraint firstItem="cel-img-001" firstAttribute="top" secondItem="cel-cv-001" secondAttribute="top" id="ct-c-img-t"/>
                                                <constraint firstItem="cel-img-001" firstAttribute="leading" secondItem="cel-cv-001" secondAttribute="leading" id="ct-c-img-l"/>
                                                <constraint firstAttribute="trailing" secondItem="cel-img-001" secondAttribute="trailing" id="ct-c-img-r"/>
                                                <constraint firstItem="cel-img-001" firstAttribute="height" relation="equal" constant="160" id="ct-c-img-h"/>
                                                <constraint firstItem="cel-ttl-001" firstAttribute="top" secondItem="cel-img-001" secondAttribute="bottom" constant="6" id="ct-c-ttl-t"/>
                                                <constraint firstItem="cel-ttl-001" firstAttribute="leading" secondItem="cel-cv-001" secondAttribute="leading" constant="8" id="ct-c-ttl-l"/>
                                                <constraint firstAttribute="trailing" secondItem="cel-ttl-001" secondAttribute="trailing" constant="8" id="ct-c-ttl-r"/>
                                                <constraint firstItem="cel-art-001" firstAttribute="top" secondItem="cel-ttl-001" secondAttribute="bottom" constant="2" id="ct-c-art-t"/>
                                                <constraint firstItem="cel-art-001" firstAttribute="leading" secondItem="cel-cv-001" secondAttribute="leading" constant="8" id="ct-c-art-l"/>
                                                <constraint firstAttribute="trailing" secondItem="cel-art-001" secondAttribute="trailing" constant="8" id="ct-c-art-r"/>
                                            </constraints>
                                        </view>
                                        <connections>
                                            <outlet property="artistaLabel" destination="cel-art-001" id="out-c-art"/>
                                            <outlet property="imagemObraImageView" destination="cel-img-001" id="out-c-img"/>
                                            <outlet property="tituloLabel" destination="cel-ttl-001" id="out-c-ttl"/>
                                        </connections>
                                    </collectionViewCell>
                                </cells>
                            </collectionView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="gal-sa-001"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="col-vw-001" firstAttribute="top" secondItem="gal-sa-001" secondAttribute="top" id="ct-g-col-t"/>
                            <constraint firstItem="col-vw-001" firstAttribute="leading" secondItem="gal-vw-001" secondAttribute="leading" id="ct-g-col-l"/>
                            <constraint firstItem="gal-vw-001" firstAttribute="trailing" secondItem="col-vw-001" secondAttribute="trailing" id="ct-g-col-r"/>
                            <constraint firstItem="gal-sa-001" firstAttribute="bottom" secondItem="col-vw-001" secondAttribute="bottom" id="ct-g-col-b"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="Artistas Curitibanos" id="gal-ni-001"/>
                    <connections>
                        <outlet property="collectionView" destination="col-vw-001" id="out-g-cv"/>
                        <segue destination="det-vc-001" kind="show" identifier="mostrarDetalhe" id="seg-001-001"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="gal-fr-001" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="200" y="0"/>
        </scene>
        <!--Detalhe View Controller-->
        <scene sceneID="det-sc-001">
            <objects>
                <viewController id="det-vc-001" customClass="DetalheViewController" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="det-vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="808"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="det-img-001">
                                <rect key="frame" x="16" y="16" width="361" height="280"/>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Título" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="det-ttl-001">
                                <rect key="frame" x="16" y="312" width="361" height="29"/>
                                <fontDescription key="fontDescription" style="UICTFontTextStyleTitle2"/>
                                <color key="textColor" systemColor="labelColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="por Artista" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="det-art-001">
                                <rect key="frame" x="16" y="349" width="361" height="22"/>
                                <fontDescription key="fontDescription" style="UICTFontTextStyleHeadline"/>
                                <color key="textColor" systemColor="labelColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Ano: 0000" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="det-ano-001">
                                <rect key="frame" x="16" y="375" width="361" height="20"/>
                                <fontDescription key="fontDescription" style="UICTFontTextStyleSubhead"/>
                                <color key="textColor" systemColor="secondaryLabelColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Estilo: Estilo" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="det-est-001">
                                <rect key="frame" x="16" y="399" width="361" height="20"/>
                                <fontDescription key="fontDescription" style="UICTFontTextStyleSubhead"/>
                                <color key="textColor" systemColor="secondaryLabelColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Descrição da obra/artista" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="det-dsc-001">
                                <rect key="frame" x="16" y="435" width="361" height="80"/>
                                <fontDescription key="fontDescription" style="UICTFontTextStyleBody"/>
                                <color key="textColor" systemColor="labelColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="det-sa-001"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="det-img-001" firstAttribute="top" secondItem="det-sa-001" secondAttribute="top" constant="16" id="ct-d-img-t"/>
                            <constraint firstItem="det-img-001" firstAttribute="leading" secondItem="det-sa-001" secondAttribute="leading" constant="16" id="ct-d-img-l"/>
                            <constraint firstItem="det-sa-001" firstAttribute="trailing" secondItem="det-img-001" secondAttribute="trailing" constant="16" id="ct-d-img-r"/>
                            <constraint firstItem="det-img-001" firstAttribute="height" relation="equal" constant="280" id="ct-d-img-h"/>
                            <constraint firstItem="det-ttl-001" firstAttribute="top" secondItem="det-img-001" secondAttribute="bottom" constant="16" id="ct-d-ttl-t"/>
                            <constraint firstItem="det-ttl-001" firstAttribute="leading" secondItem="det-sa-001" secondAttribute="leading" constant="16" id="ct-d-ttl-l"/>
                            <constraint firstItem="det-sa-001" firstAttribute="trailing" secondItem="det-ttl-001" secondAttribute="trailing" constant="16" id="ct-d-ttl-r"/>
                            <constraint firstItem="det-art-001" firstAttribute="top" secondItem="det-ttl-001" secondAttribute="bottom" constant="8" id="ct-d-art-t"/>
                            <constraint firstItem="det-art-001" firstAttribute="leading" secondItem="det-sa-001" secondAttribute="leading" constant="16" id="ct-d-art-l"/>
                            <constraint firstItem="det-sa-001" firstAttribute="trailing" secondItem="det-art-001" secondAttribute="trailing" constant="16" id="ct-d-art-r"/>
                            <constraint firstItem="det-ano-001" firstAttribute="top" secondItem="det-art-001" secondAttribute="bottom" constant="4" id="ct-d-ano-t"/>
                            <constraint firstItem="det-ano-001" firstAttribute="leading" secondItem="det-sa-001" secondAttribute="leading" constant="16" id="ct-d-ano-l"/>
                            <constraint firstItem="det-sa-001" firstAttribute="trailing" secondItem="det-ano-001" secondAttribute="trailing" constant="16" id="ct-d-ano-r"/>
                            <constraint firstItem="det-est-001" firstAttribute="top" secondItem="det-ano-001" secondAttribute="bottom" constant="4" id="ct-d-est-t"/>
                            <constraint firstItem="det-est-001" firstAttribute="leading" secondItem="det-sa-001" secondAttribute="leading" constant="16" id="ct-d-est-l"/>
                            <constraint firstItem="det-sa-001" firstAttribute="trailing" secondItem="det-est-001" secondAttribute="trailing" constant="16" id="ct-d-est-r"/>
